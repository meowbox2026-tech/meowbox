# AdMob identifiers are issued by the Meow Line AdMob account. Keep them out of git.
VITE_ADMOB_APP_ID=
VITE_ADMOB_INTERSTITIAL_ID=
VITE_ADMOB_REWARDED_ID=

# Use test ads during development. Set to false only for a reviewed release build.
VITE_ADMOB_TESTING=true

# Optional remote game-content manifest override for a staging environment.
# Leave empty for deployed web/iOS defaults. Local development skips remote updates unless overridden.
VITE_GAME_CONTENT_URL=

# Server-side Cloudflare Pages build secret used only to sign remote JSON manifests.
# Never add the VITE_ prefix; this private key must not be included in browser or app bundles.
GAME_CONTENT_SIGNING_PRIVATE_KEY=

# Public Supabase project settings for anonymous gameplay analytics.
# Use the publishable key from the meowbox2026-tech Supabase project.
VITE_SUPABASE_URL=https://vistyxmouvqbkqetejbh.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
